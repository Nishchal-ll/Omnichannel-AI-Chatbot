# ==============================================================================
# Apex Auto Recondition Nepal — AI Customer Support Environment Configuration
# ==============================================================================

# ── 1. Meta WhatsApp Cloud API (v21.0) ─────────────────────────────────────────
# Get these from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_WEBHOOK_TOKEN=apex_recondition_webhook_secret_token

# ── 2. Meta Facebook Messenger API (v21.0) ────────────────────────────────────
# Get Page Access Token from Meta Developer App -> Messenger -> Instagram / Page Settings
MESSENGER_PAGE_TOKEN=your_facebook_page_access_token_here
MESSENGER_APP_SECRET=your_meta_app_secret_here
MESSENGER_WEBHOOK_TOKEN=apex_recondition_webhook_secret_token

# ── 3. Ollama Local LLM Engine ────────────────────────────────────────────────
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=160
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# ── 4. ChromaDB & Retrieval Settings ──────────────────────────────────────────
COLLECTION_NAME=car_inventory_kb
OOD_DISTANCE=0.75

# ── 5. Server Port ────────────────────────────────────────────────────────────
PORT=8080
